# Aqui eu defino as variaveis do ambiente. Copio este arquivo para .env e troco os valores.
# O arquivo .env nunca vai para o GitHub (esta no .gitignore).

# Porta em que a API fica disponivel no host
APP_PORT=8080

# Porta do Oracle no host (o compose publica so no localhost)
ORACLE_PORT=1521

# Senha do administrador do Oracle (usuario system)
ORACLE_PASSWORD=troque_a_senha_do_admin

# Usuario e senha que a aplicacao usa para entrar no banco
ORACLE_APP_USER=esg
ORACLE_APP_PASSWORD=esg_local_password

# Segredo usado para assinar os tokens JWT (minimo de 32 caracteres)
JWT_SECRET=chave-local-de-desenvolvimento-com-mais-de-32-caracteres
